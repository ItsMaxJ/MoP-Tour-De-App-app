# Used by docker compose (see root compose.yaml). All services share the host network, so the DB is on 127.0.0.1 (TCP; "localhost" makes MySQL clients use a Unix socket).
PORT=3001
FLASK_DB_HOST=127.0.0.1
FLASK_DB_PORT=3306
FLASK_DB_NAME=product
FLASK_DB_USER=tda_user
FLASK_DB_PASSWORD=strongPassword?
